# Projeto Vida / AXIS - Backend
# Copie para .env e ajuste se necessário (opcional).
# Em hospedagem (Render, Railway, etc.) a porta é definida automaticamente.

PORT=3006
NODE_ENV=development

# ---- Bot WhatsApp 24/7 (opcional) - use Cloud API para funcionar sem QR ----
# Quando definidas, o bot usa Meta Cloud API – funciona 24h sem pareamento.
# Configure em developers.facebook.com (App WhatsApp Business API).
# WA_CLOUD_API_ACCESS_TOKEN=seu_token_de_acesso
# WA_PHONE_NUMBER_ID=id_do_numero_no_meta
# WA_WEBHOOK_VERIFY_TOKEN=axis-packing-bot
