# Copie este ficheiro para: config/selbetti.env
# (config/selbetti.env está no .gitignore — não commitar senhas.)
#
# Credenciais do Portal do Cliente Selbetti (canal_cliente_novo), NÃO da WAP do técnico.
# As linhas não podem começar por # senão são ignoradas.

SELBETTI_PORTAL_USER=seu_usuario_portal_cliente
SELBETTI_PORTAL_PASSWORD=sua_senha_portal_cliente
# Alternativa: deixe PASSWORD vazio e crie config/data/selbetti-portal-password.txt com a senha numa linha (evita # no .env).

# Opcional
# SELBETTI_PLAYWRIGHT_CHANNEL=chrome
# SELBETTI_PLAYWRIGHT_HEADED=1
# SELBETTI_PLAYWRIGHT_DEBUG=1
